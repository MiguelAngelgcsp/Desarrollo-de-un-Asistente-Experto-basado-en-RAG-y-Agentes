# Copia este archivo a .env y completa tus claves. NUNCA subas .env al repositorio.
# En la nube (Streamlit Cloud, Hugging Face, Render…) define estas mismas variables como secrets de la plataforma.

# LLM (Groq) — https://console.groq.com
GROQ_API_KEY=gsk_PEGA_TU_KEY_AQUI
GROQ_MODEL=openai/gpt-oss-120b

# Búsqueda web (Tavily) — https://app.tavily.com  (sin esta clave el agente funciona, pero sin búsqueda web)
TAVILY_API_KEY=tvly-PEGA_TU_KEY_AQUI

# Solo para la evaluación con Ragas (juez Gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
